<UserControl x:Class="OrderAlert.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="监控时段" FontWeight="SemiBold" FontSize="16"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                <TextBox Width="100" Text="{Binding MonitoringStart, UpdateSourceTrigger=LostFocus}" Padding="8"/>
                <TextBlock Text=" 至 " VerticalAlignment="Center"/>
                <TextBox Width="100" Text="{Binding MonitoringEnd, UpdateSourceTrigger=LostFocus}" Padding="8"/>
            </StackPanel>
            <TextBlock Text="检查间隔（5–120 分钟）"/>
            <TextBox Width="160" HorizontalAlignment="Left" Margin="0,8,0,18" Padding="8"
                     Text="{Binding CheckIntervalMinutes, UpdateSourceTrigger=LostFocus}"/>
            <TextBlock Text="复报间隔（分钟）"/>
            <TextBox Width="160" HorizontalAlignment="Left" Margin="0,8,0,18" Padding="8"
                     Text="{Binding RepeatIntervalMinutes, UpdateSourceTrigger=LostFocus}"/>
            <CheckBox Content="显示 Windows 弹窗" IsChecked="{Binding PopupEnabled}" Margin="0,5"/>
            <CheckBox Content="播放提醒声音" IsChecked="{Binding SoundEnabled}" Margin="0,5"/>
            <CheckBox Content="登录失效时提醒" IsChecked="{Binding LoginFailureNotificationEnabled}" Margin="0,5"/>
            <CheckBox Content="开机自动启动" IsChecked="{Binding AutoStartEnabled}" Margin="0,5"/>
            <Button Content="保存设置" Command="{Binding SaveSettingsCommand}" Width="120"
                    HorizontalAlignment="Left" Margin="0,22,0,0" Padding="12,7"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
