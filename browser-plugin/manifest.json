{
  "manifest_version": 3,
  "name": "商品采集助手",
  "version": "1.0.0",
  "description": "一键采集各大平台商品信息，导入到商品采集上架营销系统",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.dianxiaomi.com/*",
    "https://*.aliexpress.com/*",
    "https://*.1688.com/*",
    "https://*.taobao.com/*",
    "https://*.tmall.com/*",
    "https://*.amazon.com/*",
    "https://*.amazon.cn/*",
    "https://*.ozon.ru/*",
    "https://*.joom.com/*",
    "https://*.myshopify.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background-entry.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dianxiaomi.com/*",
        "https://*.aliexpress.com/*",
        "https://*.1688.com/*",
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.amazon.com/*",
        "https://*.amazon.cn/*",
        "https://*.ozon.ru/*",
        "https://*.joom.com/*",
        "https://*.myshopify.com/*"
      ],
      "js": ["content.js"]
    },
    {
      "matches": [
        "https://*.dianxiaomi.com/web/order/*",
        "https://csp.aliexpress.com/m_apps/order-manage/orderList*"
      ],
      "js": [
        "order-alert/scan-schema.js",
        "order-alert/dom-utils.js",
        "order-alert/dianxiaomi-adapter.js",
        "order-alert/aliexpress-adapter.js",
        "order-alert/scan-coordinator.js",
        "order-alert/content-order-alert.js"
      ]
    }
  ]
}
